# ==============================================================================
# Homebrew Manager — Docker Compose Environment Configuration (.env)
# Copy to `.env` next to `compose.yaml` and customize as needed.
# ==============================================================================

# Container image to pull (default: latest multi-arch build from GitHub Container Registry).
# Pin a release version like `ghcr.io/grapitygrape/5e-homebrew-manager:0.8.0` if preferred.
HBM_IMAGE=ghcr.io/grapitygrape/5e-homebrew-manager:latest

# Host data directory mounted to `/data` inside the container.
# - Portable default (Linux / macOS / Windows Docker Desktop): ./data
# - Synology DSM Container Manager example: /volume1/docker/5e-homebrew-manager/data
HBM_DATA_DIR=./data

# Process UID / GID inside the container (ensures files written to /data match your host user).
# - Standard Linux default: 1000 / 1000
# - Synology DSM typical admin user: PUID=1026 / PGID=100 (run `id` over SSH to verify)
PUID=1000
PGID=1000
TZ=UTC

# Published host ports
HBM_MANAGER_PORT=5052
HBM_BRIDGE_PORT=5051
HBM_PREVIEW_PORT=5050
HBM_SITE_PORT=8080

# Public / LAN URL of the live published site (served on :8080).
# Used for "Open live site" links and item deep-links.
# Examples:
#   http://synology.local:8080
#   https://5e.example.com
HBM_SITE_URL=

# Optional subpath prefix for the live published site on :8080 (default `/`).
# Example: `/5e` if reverse-proxied under `https://nas.local/5e/`
HBM_SITE_BASE_PATH=/

# Optional public / LAN URL override for the candidate preview server (:5050).
# Leave blank to use the browser's current hostname and HBM_PREVIEW_PORT (`http://<host>:5050`).
HBM_PREVIEW_URL=

# Optional HTTP Basic Auth protecting the Manager UI (:5052) and Candidate Preview (:5050).
# The live player-facing site (:8080), `/api/health`, `/api/foundry/*`, and
# `/api/bridge/*` remain accessible without Basic Auth.
HBM_AUTH_USER=
HBM_AUTH_PASS=

# Optional shared secret token required by `/api/foundry/{stream,result,state}`.
# When set, paste the same token into Foundry VTT -> Module Settings -> Homebrew Manager Bridge.
HBM_BRIDGE_TOKEN=

# Optional comma-separated list of allowed Foundry VTT origins for CORS on `/api/foundry/*`.
# Example: http://synology.local:30000,https://foundry.example.com
HBM_FOUNDRY_URLS=
