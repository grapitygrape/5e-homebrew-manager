{
  "title": "Use home page override",
  "description": "Replaces the 5etools home page with your own index.html. Skipped while the file doesn't exist.",
  "order": 50,
  "defaultEnabled": true,
  "options": [
    {
      "id": "file",
      "label": "Home page file",
      "kind": "path",
      "default": "{data}/content/home-page.html"
    }
  ],
  "entries": [
    {
      "type": "copy",
      "description": "Home page",
      "source": "{option:file}",
      "target": "index.html",
      "ifExists": true
    }
  ]
}
