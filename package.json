{
  "name": "5e-homebrew-manager",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Tauri v2 (Rust) + Svelte 5 desktop manager for 5e homebrew, repo locking, overrides pipeline, and local site server.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:web": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/dev-web.ts",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "scripts:bundle": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/bundle-injected.ts",
    "guides:enums": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/guide-enums.ts",
    "audit": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/audit.ts",
    "upstream:check": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/upstream-check.ts",
    "upstream:update": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/upstream-update.ts",
    "release": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint **/*.{css,svelte}",
    "mimic:sync": "node ../mimic-ui/scripts/sync.mjs src/lib/ui/mimic --files=tokens,components",
    "mimic:check": "node -e \"if (require('node:fs').existsSync('../mimic-ui/scripts/sync.mjs')) require('node:child_process').execFileSync(process.execPath, ['../mimic-ui/scripts/sync.mjs', 'src/lib/ui/mimic', '--check'], { stdio: 'inherit' }); else console.log('mimic:check skipped (../mimic-ui not present)');\"",
    "verify": "npm run scripts:bundle -- --check && npm run check && npm test && npm run mimic:check && npm run audit -- --quiet --if-configured && npm run guides:enums -- --if-configured"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^24.0.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.14.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.0.0",
    "@tauri-apps/api": "^2.5.0",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "marked": "^18.0.5"
  }
}
