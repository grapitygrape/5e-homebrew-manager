# Copy this file to .env in this folder and fill in the values. Keep .env private.
# Each NAME=value line reaches your deploy scripts (scripts/) as an
# environment variable. The app itself doesn't use them.

# Example: the tokens for a script that purges the Cloudflare cache.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_BASE_URL=https://5e.example.com

# The app also gives every script these. Don't set them here:
#   HBM_SITE_DIR        the 5e site checkout
#   HBM_DEPLOY_FOLDERS  the site deploy folders, one per line
#   HBM_CHANGED_FILES   site paths a cache purge should cover, one per line
